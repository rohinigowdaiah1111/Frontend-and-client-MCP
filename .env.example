# Copy to .env and fill in. Never commit real secrets.
GROQ_API_KEY=your_groq_api_key_here

# Docs/Gmail MCP server (docs/phase0/MCP_INVENTORY.md) — used by src/adapters/mcp_client.py
# and webapp/app.py for Phase 5 (Docs) / Phase 6 (Gmail draft, draft-only).
MCP_SERVER_URL=https://your-mcp-server.onrender.com
MCP_AUTH_TOKEN=your_mcp_bearer_token_here
DOCS_PULSE_DOCUMENT_ID=your_google_doc_id_here
GMAIL_DRAFT_TO=you@example.com

# webapp/ (Review Pulse Console) shared-password gate. Leave unset to disable
# the login screen entirely (fine for local dev, not for a public deployment).
WEBAPP_PASSWORD=choose_a_strong_password_here
